# PostgreSQL (docker compose up -d gives you this one)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planner"
# Used by `npm test` for integration tests. Never point this at real data: tests wipe it.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planner_test"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional: any OpenAI-compatible chat completions API (OpenAI, OpenRouter, Groq, local Ollama...).
# Leave empty and "Plan my week" falls back to the built-in scheduler.
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY=""
LLM_MODEL="openai/gpt-4o-mini"
